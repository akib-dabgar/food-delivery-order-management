# Environment variables read by the API server (server/src/config.ts).
#
# The app does NOT load .env files automatically — there is no dotenv
# dependency. Set these in your shell or in your hosting provider's
# environment settings. Both have working defaults, so you can ignore
# this file entirely for local development.
#
#   Windows PowerShell:  $env:STATUS_STEP_MS = "3000"; npm run dev:server
#   macOS / Linux:       STATUS_STEP_MS=3000 npm run dev:server

# Port the API server listens on. Default: 3001
# The Vite dev proxy in client/vite.config.ts targets 3001, so if you change
# this you must change the proxy target too.
PORT=3001

# Milliseconds an order spends on each status before the simulator advances it
# (ORDER_RECEIVED -> PREPARING -> OUT_FOR_DELIVERY -> DELIVERED).
# Default: 15000. Lower it to a few seconds when demonstrating the app.
STATUS_STEP_MS=15000
